{
  "name": "cape-town-atlas",
  "private": true,
  "version": "2.0.0",
  "description": "Cape Town Atlas — an interactive field guide to the Mother City. Live 3D map, curated districts, cinematic stories, real sun and weather.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "verify:data": "node scripts/verify-data.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.7.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
